{
    "name": "componenta/auth-session-database",
    "description": "Cycle Database persistence for Componenta authentication sessions",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "componenta/auth-session": "dev-main",
        "componenta/clock": "^1.1.0",
        "componenta/identity": "^1.0",
        "cycle/database": "^2.22",
        "psr/clock": "^1.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "Componenta\\Auth\\Session\\Database\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Componenta\\Auth\\Session\\Database\\Tests\\": "tests/"
        }
    },
    "repositories": [
        {"type": "vcs", "url": "https://github.com/componenta/auth.git"},
        {"type": "vcs", "url": "https://github.com/componenta/auth-session.git"}
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {"branch-alias": {"dev-main": "1.0.x-dev"}},
    "config": {"sort-packages": true},
    "scripts": {
        "test": "@php vendor/bin/phpunit --configuration phpunit.xml.dist",
        "phpstan": "@php vendor/bin/phpstan analyse src --level=max",
        "check": ["@phpstan", "@test"]
    }
}
